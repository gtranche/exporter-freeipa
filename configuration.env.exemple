# Valeurs propres a votre site. Copiez ce fichier en « configuration.env » a
# cote de celui-ci, et ajustez : il est ignore par git, rien n en remonte.
#
#     cp configuration.env.exemple configuration.env
#
# Les adresses et noms ci-dessous sont ceux des plages reservees a la
# documentation (RFC 5737, RFC 2606) : ils ne joignent rien.

# --- la machine FreeIPA ------------------------------------------------------

# Adresse ou nom par lequel Prometheus joint la machine. Son node_exporter doit
# y ecouter : le collecteur textfile sert les series de l exportateur.
ADRESSE_FREEIPA=192.0.2.10
PORT_NODE_EXPORTER=9100

# Cible ssh de cette meme machine, pour verifier-deploiement.sh seulement.
# Un compte capable de lire /etc/systemd/system et le fichier de metriques.
CIBLE_SSH=freeipa.exemple.test

# Options ssh pour joindre CETTE machine, si elles ne sont pas dans
# ~/.ssh/config. Separees de celles du cluster : les deux destinations n ont ni
# la meme cle, ni le meme rebond.
#   SSH_OPTS_FREEIPA="-i ~/.ssh/une-cle -o IdentitiesOnly=yes -J rebond"
SSH_OPTS_FREEIPA=

# --- le cluster --------------------------------------------------------------

# Machine depuis laquelle kubectl parle au cluster. Vide : kubectl est joue
# localement, ce qui est le cas courant.
HOTE_KUBECTL=
SSH_OPTS_KUBECTL=

# Namespace ou vivent Prometheus et Grafana.
NAMESPACE=monitoring

# Nom de job porte par la cible, et etiquette « host » posee sur ses series.
# Le nom de job est celui auquel l alerte FreeipaAnnuaireInjoignable se refere.
NOM_JOB=node-freeipa
ETIQUETTE_HOTE=freeipa
INTERVALLE_SCRAPE=30s

# Valeur de l etiquette « prometheus » attendue par le ruleSelector de votre
# Prometheus. « kubectl get prometheus -o yaml » la donne. Avec kube-prometheus
# c est « k8s ».
SELECTEUR_PROMETHEUS=k8s

# --- Grafana -----------------------------------------------------------------

# Deployment de Grafana, et racine sous laquelle il lit ses tableaux.
# La valeur ci-dessous est celle de kube-prometheus.
DEPLOIEMENT_GRAFANA=grafana
RACINE_TABLEAUX=/grafana-dashboard-definitions/0

# --- tests des alertes -------------------------------------------------------

# promtool n est pas un paquet separe : on l emprunte a une image Prometheus,
# dans un conteneur jetable. Laisse vide, l image exacte de votre cluster est
# relevee pour que l outil soit la version qui evaluera vraiment ces regles.
# Renseignee, les tests tournent sans cluster du tout.
IMAGE_PROMETHEUS=
MOTEUR_CONTENEUR=podman

# --- chemins sur la machine FreeIPA ------------------------------------------

# Ils varient selon la distribution et le paquet node_exporter employe. Les
# memes noms sont lus par l exportateur : une seule valeur pour les deux.
FICHIER_METRIQUES=/var/lib/node_exporter/textfile_collector/freeipa.prom
FICHIER_ETAT=/var/lib/node_exporter/etat-freeipa.json
JOURNAL_KDC=/var/log/krb5kdc.log
