    {
      "type": "table",
      "title": "Connexions ouvertes par le parc",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "label_join(freeipa_connexions_ouvertes{instance=~\"$serveur\"}, \"cle\", \" · \", \"instance\", \"identite\", \"ip\")",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "sum by (cle) (label_join(freeipa_connexion_duree_max_secondes{instance=~\"$serveur\"}, \"cle\", \" · \", \"instance\", \"identite\", \"ip\"))",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "sum by (cle) (label_join(freeipa_connexion_operations{instance=~\"$serveur\"}, \"cle\", \" · \", \"instance\", \"identite\", \"ip\"))",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "cle",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "cle": true,
              "__name__": true,
              "job": true,
              "endpoint": true,
              "namespace": true,
              "service": true,
              "host": true,
              "pod": true,
              "container": true,
              "prometheus": true,
              "prometheus_replica": true
            },
            "renameByName": {
              "Value #A": "Connexions",
              "Value #B": "Âge max (s)",
              "Value #C": "Opérations",
              "instance": "Serveur",
              "identite": "Identité",
              "ip": "Adresse"
            },
            "indexByName": {
              "instance": 0,
              "identite": 1,
              "ip": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Connexions",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Âge max (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
