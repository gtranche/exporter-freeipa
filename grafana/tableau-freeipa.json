{
  "uid": "freeipa",
  "title": "FreeIPA — identité, annuaire et Kerberos",
  "tags": [
    "freeipa",
    "identite",
    "parc"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Services actifs",
      "datasource": {
        "type": "prometheus",
        "uid": "${source}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${source}"
          },
          "expr": "freeipa_services_actifs{instance=~\"$serveur\"}",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 9
              }
            ]
          }
        },
        "overrides": []
      }
    },
